# Configuration du thème gtsummary
theme_gtsummary_journal(journal = "jama")
theme_gtsummary_language(language = "en")
table_publication <- model_bb_mixte %>%
tbl_regression(
exponentiate = TRUE,  # Coefficients exponentiés = Odds Ratios (OR)
pvalue_fun = ~ style_pvalue(.x, digits = 3),
label = list(
age                            ~ "Age (years)",
sexe                           ~ "Sex",
province                       ~ "Province of origin",
statut_matrimonial             ~ "Marital status",
duree_stage                    ~ "Internship duration (months)",
antecedent_personnel_de_cancer ~ "Personal history of cancer",
antecedent_familial_de_cancer  ~ "Family history of cancer",
perception_score               ~ "Perception score"
)
) %>%
bold_p(t = 0.05) %>%
bold_labels() %>%
modify_header(
label    ~ "**Predictors**",
estimate ~ "**OR (95% CI)**",
p.value  ~ "**p-value**"
) %>%
add_glance_source_note(
label = list(
nobs ~ "Observations",
AIC  ~ "Akaike Information Criterion (AIC)"
),
include = c(nobs, AIC)
) %>%
modify_footnote(
all_stat_cols() ~
"OR: Odds Ratio; CI: Confidence Interval. "
)
# Affichage console
table_publication
