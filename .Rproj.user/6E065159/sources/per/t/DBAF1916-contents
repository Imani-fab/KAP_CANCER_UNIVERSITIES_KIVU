# FUNCTION FOR BINARY VARIABLES (t-test)

analyse_binary <- function(var){
  
  # t-test
  
  test <- t.test(
    Cancer$knowledge_score ~ Cancer[[var]]
  )
  
  stat <- round(
    as.numeric(test$statistic),
    3
  )
  
  pval <- signif(
    test$p.value,
    3
  )
  
  # descriptive statistics
  
  tmp <- Cancer %>%
    
    group_by(.data[[var]]) %>%
    
    summarise(
      
      n = n(),
      
      Mean = mean(
        knowledge_score,
        na.rm = TRUE
      ),
      
      SD = sd(
        knowledge_score,
        na.rm = TRUE
      ),
      
      .groups = "drop"
    )
  
  names(tmp)[1] <- "Category"
  
  tmp <- tmp %>%
    
    mutate(
      
      Variable = var,
      
      Mean_Knowledge_Score =
        paste0(
          
          round(Mean,2),
          
          " (",
          
          round(SD,2),
          
          ")"
        ),
      
      Test =
        "Student t-test",
      
      Statistic =
        c(
          stat,
          rep(
            "",
            n()-1
          )
        ),
      
      P_value =
        c(
          pval,
          rep(
            "",
            n()-1
          )
        )
    ) %>%
    
    select(Variable, Category, n, Mean_Knowledge_Score, Test, Statistic, P_value)
  
  return(tmp)
}

