library(ggplot2)     # Graphiques
library(DHARMa)      # Diagnostics de résidus simulés)
library(gtsummary)   # Pour tbl_regression)
library(flextable)   # Pour l'exportation vers Word (.docx)


# Création du dossier de sortie
dir.create("output/model_analysis", showWarnings = FALSE, recursive = TRUE)

# ------------------------------------------------------------------------------
# 2. Ajustement du Modèle Adapté (Poisson & Binomiale Négative)
# ------------------------------------------------------------------------------

# Modèle A: Régression de Poisson
model_poisson <- glm(
  knowledge_score ~ age + sexe + province + statut_matrimonial +
    duree_stage + antecedent_personnel_de_cancer +
    antecedent_familial_de_cancer + perception_score,
  family = poisson(link = "log"),
  data = Cancer
)

# Test de surdispersion pour valider la Poisson
dispersion_test <- check_overdispersion(model_poisson)
print(dispersion_test)

# Modèle B: Régression Binomiale Négative (Recommandé si surdispersion décelée)
model_final <- glm.nb(
  knowledge_score ~ age + sexe + province + statut_matrimonial +
    duree_stage + antecedent_personnel_de_cancer +
    antecedent_familial_de_cancer + perception_score,
  data = Cancer
)

# Test de surdispersion pour valider le modèle Binomiale Négative
dispersion_test <- check_overdispersion(model_final)
print(dispersion_test)


# ------------------------------------------------------------------------------
# 3. Diagnostic & Vérification du Modèle Retenu
# ------------------------------------------------------------------------------

# Vérification de la multicolinéarité (VIF)
vif_final <- car::vif(model_final)
print(vif_final)

# Métriques de performance globale (R2 pseudo, RMSE, MAE, AIC)
perf <- performance(model_final)
print(perf)

# ------------------------------------------------------------------------------
# 3. Génération des Résidus Quantiles Simulés (DHARMa)
# ------------------------------------------------------------------------------

# Simulation de 1000 jeux de données sous l'hypothèse du modèle
simulation_res <- simulateResiduals(fittedModel = model_final, n = 1000)

# ------------------------------------------------------------------------------
# 4. Tests Formels de Diagnostic (DHARMa)
# ------------------------------------------------------------------------------

# A. Test d'uniformité des résidus (Kolmogorov-Smirnov Test)
test_unif <- testUniformity(simulation_res)
print(test_unif)

# B. Test de surdispersion / sous-dispersion résiduelle
test_disp <- testDispersion(simulation_res)
print(test_disp)

# C. Test des valeurs aberrantes (Outliers)
test_out <- testOutliers(simulation_res)
print(test_out)

