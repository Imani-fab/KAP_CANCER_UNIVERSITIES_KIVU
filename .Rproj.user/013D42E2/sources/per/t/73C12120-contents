# KNOWLEDGE & PERCEPTION SCORES


library(dplyr)
library(readxl)
library(stringr)


# Import Codebook


cd <- read_excel(
  "output/Codebook_V2_correct_Analyse.xlsx"
)


# Knowledge variables


knowledge_items <- cd %>%
  
  filter(
    include_in_knowledge_score == "YES"
  )


# Create binary score for each knowledge item


for(i in 1:nrow(knowledge_items)){
  
  var <- knowledge_items$french_variable[i]
  
  answer <- knowledge_items$correct_answer[i]
  
  score_var <- paste0(
    var,
    "_score"
  )
  
  Cancer[[score_var]] <-
    
   
  ifelse(
    
    is.na(Cancer[[var]]),
    
    NA,
    
    ifelse(
      as.character(
        Cancer[[var]]
      ) == answer,
      1,
      0
    )
  )
 
  
}


# Total Knowledge Score


knowledge_score_vars <-
  
  paste0(
    knowledge_items$french_variable,
    "_score"
  )

Cancer <- Cancer %>%
  
  mutate(
    
   
    knowledge_score =
      
      rowSums(
        
        select(
          .,
          all_of(
            knowledge_score_vars
          )
        ),
        
        na.rm = TRUE
      )
  
    
  )


# Knowledge Percentage


max_knowledge_score <-
  
  nrow(
    knowledge_items
  )

Cancer <- Cancer %>%
  
  mutate(
    
    
    knowledge_percentage =
      
      knowledge_score /
      max_knowledge_score *
      100
    
    
  )


